<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The on/off tile. -->
    <LinearLayout
        android:id="@+id/tile_lock"
        style="@style/Settings.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.15"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/lock_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_key"
                android:contentDescription="Child lock"
                android:padding="13dp"
                android:src="@drawable/ic_lock" />

            <TextView
                style="@style/Settings.Title"
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Child lock"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/check_lock"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_check"
                android:contentDescription="On"
                android:padding="6dp"
                android:src="@drawable/ic_check" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <!-- A miniature screen showing where to hold. -->
            <FrameLayout
                android:id="@+id/mini_lock"
                android:layout_width="168dp"
                android:layout_height="96dp">

                <ImageView
                    android:id="@+id/mini_ring"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:contentDescription="Hold here"
                    android:padding="9dp"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="46dp"
                    android:layout_marginEnd="8dp"
                    android:text="hold 3 s"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lock_summary"
                    style="@style/Settings.Body"
                    android:layout_width="match_parent"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/Settings.Body"
                    android:layout_width="match_parent"
                    android:text="The power menu is hidden while locked, so little hands can't switch the screen off either."
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- How the unlock code works, with an example. -->
    <LinearLayout
        style="@style/Settings.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="0.85">

        <TextView
            style="@style/Settings.Title"
            android:text="Unlock code" />

        <TextView
            style="@style/Settings.Body"
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            android:text="A new code every time, written out in words. Grown-ups read it and type the numbers. Nothing to remember." />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/sample_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:text="You type 5 2 8 0"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
