<?xml version="1.0" encoding="utf-8"?>
<!-- One period, painted in its own color. Ink colors are set in code to suit the background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/period_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/start_time"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="20sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:hint="Add a label"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLength="40"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:id="@+id/presets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/custom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/custom_back"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Back to preset colors"
                    android:src="@drawable/ic_chevron_left" />

                <SeekBar
                    android:id="@+id/hue"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:max="359" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/custom_swatch"
                    android:layout_width="34dp"
                    android:layout_height="34dp" />

                <SeekBar
                    android:id="@+id/shade"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:max="100" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/sun"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Brightness"
            android:src="@drawable/ic_sun" />

        <SeekBar
            android:id="@+id/brightness"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:max="19" />

        <TextView
            android:id="@+id/brightness_value"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
